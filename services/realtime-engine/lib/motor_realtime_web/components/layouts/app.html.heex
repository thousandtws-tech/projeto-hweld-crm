<header class="sticky top-0 z-30 border-b border-slate-800 bg-slate-950/80 backdrop-blur">
  <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-4 px-6 py-3">
    <div class="flex items-center gap-3">
      <div class="grid h-9 w-9 place-items-center rounded-lg bg-gradient-to-br from-orange-500 to-orange-700 shadow-lg shadow-orange-900/40">
        <.icon name="bolt" class="text-lg text-white" />
      </div>
      <div>
        <p class="text-sm font-bold leading-4">HWeld <span class="text-orange-400">Realtime</span></p>
        <p class="text-[11px] text-slate-500">Monitoramento de eventos</p>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <.live_dot online={@online} />
      <span :if={assigns[:sujeito_id]} class="text-xs text-slate-500">
        staff #{@sujeito_id}
      </span>
      <a
        href="/infra"
        class="text-xs font-medium text-sky-400 hover:text-sky-300"
      >
        Infra ↗
      </a>
      <.link href={~p"/monitor/logout"} method="delete" class="text-xs text-slate-400 hover:text-white">
        Sair
      </.link>
    </div>
  </div>
</header>

<main class="mx-auto max-w-[1400px] px-6 py-6">
  {@inner_content}
</main>
