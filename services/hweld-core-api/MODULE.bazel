"""HWeld Bazel module (bzlmod).

Bazel build configuration for the HWeld Rust workspace.
Uses rules_rust with crate_universe to consume the existing Cargo.lock.
"""

module(
    name = "hweld",
    version = "0.1.0",
)

# Core Bazel dependencies
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_rust", version = "0.60.0")

# Rust toolchain
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.86.0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

# Crate universe: resolve crates.io dependencies from Cargo.lock
# The generated lockfile (CARGO.Bazel.lock) is committed to the repo.
crate = use_extension("@rules_rust//crate_universe:extension.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//crates/api:Cargo.toml",
        "//crates/application:Cargo.toml",
        "//crates/domain:Cargo.toml",
        "//crates/infrastructure:Cargo.toml",
        "//crates/server:Cargo.toml",
    ],
    # Lockfile produced by crate_universe; run `bazel run @crates//:vendor` to regenerate.
    lockfile = "//:CARGO.Bazel.lock",
)
use_repo(crate, "crates")
