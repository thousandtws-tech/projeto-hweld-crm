# hweld-operations-api — exemplo de variáveis de ambiente
# NUNCA versionar valores reais. Copie para .env local / secrets do deploy.

PORT=8090
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hweld
DB_USER=hweld
DB_PASSWORD=hweld

# Segredos compartilhados (obrigatórios — fail-fast sem eles)
JWT_SECRET=troque-por-um-segredo-hs256-de-32-bytes-ou-mais
INTERNAL_SERVICE_TOKEN=troque-pelo-mesmo-token-do-core-api

# Swagger/api-docs — off por default (dev opt-in). Prod NUNCA liga.
API_DOCS_ENABLED=true

# Guarda de borda — mesmo segredo do Worker Cloudflare. Em prod exige
# `X-Edge-Token` em todo request exceto /actuator/** e /api/v1/internal/**.
# Vazio = guarda desligada (dev local).
EDGE_TOKEN=

# Core-api / realtime
CORE_API_URL=http://localhost:8080
CORE_API_TIMEOUT_MS=4000
MOTOR_URL=http://localhost:4100
MOTOR_INGEST_TOKEN=

# CORS (dev: painel Vite). Produção = same-origin via Worker — deixar apertado.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Fiscal / Spedy ──────────────────────────────────────────────────────
# auto (Spedy se credenciada no banco, senão stub) | stub | spedy
FISCAL_PROVIDER=auto
FISCAL_AUTO_EMIT=false
FISCAL_AMBIENTE=homologacao
# Credenciais Spedy são do CLIENTE — cifradas no banco via painel
# (Administração → Integrações → Spedy). Emitente, certificado, série e
# regime vivem no backoffice Spedy, identificados pela X-Api-Key.

# Defaults fiscais NF-e — revisar com o contador (o sistema não calcula tributos)
FISCAL_NFE_NATUREZA_OPERACAO=Venda de mercadoria
FISCAL_NFE_CFOP=
FISCAL_NFE_UNIDADE=UN
FISCAL_NFE_ICMS_ORIGEM=0
FISCAL_NFE_ICMS_ST=
FISCAL_NFE_PIS_ST=
FISCAL_NFE_COFINS_ST=

# Reconciliação de documentos não-terminais
FISCAL_RECONCILE_INTERVAL_MS=120000
FISCAL_RECONCILE_MIN_AGE_MS=60000
FISCAL_RECONCILE_BATCH_SIZE=20

# Object storage (XML/DANFE) — vazio = NoopObjectStorage (dev sem MinIO)
MINIO_ENDPOINT=
MINIO_BUCKET=hweld
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# E-mail
EMAIL_PROVIDER=log
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@hweld.com.br
MAIL_FROM_NAME=HWeld

# SMS transacional — auto (Infobip se credenciado no banco, senão log) | log | infobip
SMS_PROVIDER=auto
# Credenciais Infobip são do CLIENTE — cifradas no banco via painel
# (Administração → Integrações). Abaixo só ajustes de plataforma:
#INFOBIP_TIMEOUT_MS=10000
#APP_PUBLIC_URL=https://<domínio público deste serviço>   (base da URL do DLR)
#INTEGRATION_SECRETS_KEY=<hex-64 ou base64>              (vazio = deriva de JWT_SECRET)
