# hweld-operations-api — exemplo de variáveis de ambiente
# NUNCA versionar valores reais. Copie para .env local / secrets do deploy.

PORT=8090
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hweld
DB_USER=hweld
DB_PASSWORD=hweld

# Segredos compartilhados (obrigatórios — fail-fast sem eles)
JWT_SECRET=troque-por-um-segredo-hs256-de-32-bytes-ou-mais
INTERNAL_SERVICE_TOKEN=troque-pelo-mesmo-token-do-core-api

# Swagger/api-docs — off por default (dev opt-in). Prod NUNCA liga.
API_DOCS_ENABLED=true

# Guarda de borda — mesmo segredo do Worker Cloudflare. Em prod exige
# `X-Edge-Token` em todo request exceto /actuator/** e /api/v1/internal/**.
# Vazio = guarda desligada (dev local).
EDGE_TOKEN=

# Core-api / realtime
CORE_API_URL=http://localhost:8080
CORE_API_TIMEOUT_MS=4000
MOTOR_URL=http://localhost:4100
MOTOR_INGEST_TOKEN=

# CORS (dev: painel Vite). Produção = same-origin via Worker — deixar apertado.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Fiscal / Focus NFe ──────────────────────────────────────────────────
FISCAL_PROVIDER=stub            # stub | focusnfe
FISCAL_AUTO_EMIT=false
FISCAL_AMBIENTE=homologacao

FOCUS_NFE_ENV=homologacao       # homologacao | producao
FOCUS_NFE_HOMOLOGATION_URL=https://homologacao.focusnfe.com.br
FOCUS_NFE_PRODUCTION_URL=https://api.focusnfe.com.br
FOCUS_NFE_HOMOLOGATION_TOKEN=
FOCUS_NFE_PRODUCTION_TOKEN=
FOCUS_NFE_PRODUCTION_ENABLED=false   # OBRIGATÓRIO true p/ emitir em produção
FOCUS_NFE_TIMEOUT_MS=30000
FOCUS_NFE_DOWNLOAD_TIMEOUT_MS=15000

# Webhook: segredo registrado no hook da Focus (par `authorization`)
FOCUS_NFE_WEBHOOK_AUTH_TOKEN=
FOCUS_NFE_WEBHOOK_AUTH_HEADER=X-Webhook-Token
FOCUS_NFE_WEBHOOK_URL=

# Emitente NF-e (a empresa que opera o sistema)
FOCUS_NFE_EMITENTE_CNPJ=
FOCUS_NFE_EMITENTE_NOME=
FOCUS_NFE_EMITENTE_NOME_FANTASIA=
FOCUS_NFE_EMITENTE_IE=
FOCUS_NFE_EMITENTE_LOGRADOURO=
FOCUS_NFE_EMITENTE_NUMERO=
FOCUS_NFE_EMITENTE_BAIRRO=
FOCUS_NFE_EMITENTE_MUNICIPIO=
FOCUS_NFE_EMITENTE_UF=
FOCUS_NFE_EMITENTE_CEP=
FOCUS_NFE_EMITENTE_REGIME_TRIBUTARIO=1
FOCUS_NFE_EMITENTE_IM=

# Defaults fiscais NF-e — revisar com o contador (o sistema não calcula tributos)
FOCUS_NFE_NATUREZA_OPERACAO=Venda de mercadoria
FOCUS_NFE_CFOP=
FOCUS_NFE_UNIDADE=UN
FOCUS_NFE_ICMS_ORIGEM=0
FOCUS_NFE_ICMS_ST=
FOCUS_NFE_PIS_ST=
FOCUS_NFE_COFINS_ST=

# Reconciliação de documentos não-terminais
FISCAL_RECONCILE_INTERVAL_MS=120000
FISCAL_RECONCILE_MIN_AGE_MS=60000
FISCAL_RECONCILE_BATCH_SIZE=20

# Object storage (XML/DANFE) — vazio = NoopObjectStorage (dev sem MinIO)
MINIO_ENDPOINT=
MINIO_BUCKET=hweld
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# E-mail
EMAIL_PROVIDER=log
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@hweld.com.br
MAIL_FROM_NAME=HWeld

# SMS transacional — log (dev) | infobip
SMS_PROVIDER=log
#INFOBIP_BASE_URL=https://<sua-conta>.api.infobip.com
#INFOBIP_API_KEY=
#INFOBIP_SENDER=
#INFOBIP_DLR_AUTH_TOKEN=
#INFOBIP_DLR_AUTH_HEADER=X-DLR-Token
#INFOBIP_WEBHOOK_URL=
