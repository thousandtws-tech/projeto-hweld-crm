# ── Servidor ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=production
RUN_MIGRATIONS=false
SEED_ADMIN=false
CORS_PERMISSIVE=false
CORS_ORIGINS=https://app.seudominio.com

# ── Banco ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:SENHA@host:porta/banco
DB_MAX_CONNECTIONS=50

# ── Segurança ─────────────────────────────────────────────────────────────
JWT_SECRET=JWT_SECRET_AQUI
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# ── Admin inicial ─────────────────────────────────────────────────────────
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@seudominio.com
ADMIN_SENHA=SENHA_ADMIN

# ── Login social (Auth0 — broker Google/Apple) ───────────────────────────
# Ambas ausentes = feature desligada; POST /auth/portal/social responde 503.

# ── Busca (Elasticsearch) ───────────────────────────────────────────────
ELASTICSEARCH_URL=https://elasticsearch.seudominio.com
ELASTICSEARCH_INDEX_PRODUTOS=hweld_produtos
ELASTICSEARCH_USERNAME=admin
ELASTICSEARCH_PASSWORD=SENHA_ES
ES_ENSURE_INDEX=false

# ── Logs ──────────────────────────────────────────────────────────────────
RUST_LOG=info,hweld=info,sqlx=warn,actix_web=info
