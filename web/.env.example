# URL do backend REST (Actix) consumida pelo BFF GraphQL.
# API_INTERNAL_URL tem precedência server-side; NEXT_PUBLIC_API_URL é o fallback.
API_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Timeout (ms) das chamadas do BFF ao backend. Opcional — padrão 15000.
# API_TIMEOUT_MS=15000
