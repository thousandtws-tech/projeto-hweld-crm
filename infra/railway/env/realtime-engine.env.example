# Referência das variáveis do serviço realtime-engine (Phoenix) no Railway.
# Aplicar com: railway variable set -s realtime-engine KEY=VALUE

PHX_SERVER=true
SECRET_KEY_BASE=<gerar: openssl rand -hex 64>
JWT_SECRET=<MESMO valor do JWT_SECRET do core-api — valida tokens HS256>
MOTOR_INGEST_TOKEN=<segredo compartilhado com core-api (mesma var lá)>
MOTOR_PORT=4100
DATABASE_URL=${{Postgres.DATABASE_URL}}
RUST_API_URL=http://core-api.railway.internal:8080/api/v1
PHX_HOST=realtime-engine-production-081f.up.railway.app
CORS_ORIGINS=https://hweld-loja.vinicius-softengineer.workers.dev,https://hweld-admin.vinicius-softengineer.workers.dev

# Opcional — cluster Erlang via DNS (multi-réplica):
# DNS_CLUSTER_QUERY=...
