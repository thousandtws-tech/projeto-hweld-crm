# Referência das variáveis do serviço operations-api (Java/Spring Boot) no Railway.
# Aplicar com: railway variable set -s operations-api KEY=VALUE
# (segredos reais NÃO ficam aqui — gerar e aplicar via CLI)

# Postgres — mesmo banco do core-api (tabelas Java convivem no schema public).
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_NAME=${{Postgres.PGDATABASE}}
DB_USER=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}

# Mesmo segredo HS256 do core-api — valida JWTs staff/portal.
JWT_SECRET=<o mesmo valor do core-api>

# Token service-to-service: o Java posta eventos financeiros em
# POST {CORE_API_URL}/api/v1/internal/eventos-financeiros com X-Service-Token.
# O MESMO valor precisa estar no core-api (senão o endpoint responde 503).
INTERNAL_SERVICE_TOKEN=<gerar: openssl rand -hex 32>

CORE_API_URL=http://core-api.railway.internal:8080
CORE_API_TIMEOUT_MS=4000

# Docs da API — off por default (fail-safe); NUNCA ligar em prod.
API_DOCS_ENABLED=false

# Guarda de borda — OBRIGATÓRIO em prod: origem exige `x-edge-token` em todo
# request exceto /actuator/** e /api/v1/internal/**. Mesmo segredo do Worker.
# Webhooks do PSP/fiscal chamam a URL pública da edge (o Worker injeta o
# token) — nunca registrar webhook apontando direto para *.up.railway.app.
EDGE_TOKEN=<mesmo segredo do Worker — openssl rand -hex 32>

# Object storage MinIO — XML/PDF fiscal em `fiscal/{id}.*` no bucket `hweld`.
# Endpoint ausente = NoopObjectStorage (dev sem infra). O core-api usa um
# bucket SEPARADO `hweld-uploads` (midia/* + cms/loja.json) com as mesmas
# credenciais — mesmas vars lá, só troca MINIO_BUCKET.
MINIO_ENDPOINT=https://bucket-production-e903.up.railway.app
MINIO_BUCKET=hweld
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=<access key do MinIO>
MINIO_SECRET_KEY=<secret key do MinIO>

# Pagamento — auto usa as credenciais que o CLIENTE cadastra no painel
# (Integrações → PagBank, cifradas AES-256 no banco). stub força dev;
# pagbank exige credenciado. Timeout do client PagBank é opcional.
PAYMENT_PROVIDER=auto
PAGBANK_TIMEOUT_MS=10000
MERCADOPAGO_TIMEOUT_MS=10000
PAYMENT_PIX_EXPIRATION_MINUTES=30
PAYMENT_STUB_WEBHOOK_SECRET=<gerar>
FISCAL_PROVIDER=auto
FISCAL_AUTO_EMIT=false
FISCAL_AMBIENTE=homologacao
# Logística — auto usa credenciais que o CLIENTE cadastra no painel
# (Integrações → Melhor Envio, cifradas AES-256 no banco). stub força dev;
# melhorenvio exige credenciado.
LOGISTICS_PROVIDER=auto
#LOGISTICS_TIMEOUT_MS=15000
# User-Agent obrigatório da API Melhor Envio (app + e-mail de contato):
#LOGISTICS_USER_AGENT="HWeld Operations (contato@hweld.com.br)"
EMAIL_PROVIDER=log
# Para SMTP real: EMAIL_PROVIDER=smtp + SMTP_HOST/SMTP_PORT/SMTP_USERNAME/SMTP_PASSWORD/MAIL_FROM

# SMS transacional — auto usa credenciais que o CLIENTE cadastra no painel
# (Integrações → Infobip, cifradas AES-256 no banco). log força dev; infobip exige credenciado.
SMS_PROVIDER=auto
# Base pública para a URL do DLR exibida no card (sem ela, deriva do request):
APP_PUBLIC_URL=https://operations-api-production-d580.up.railway.app
# Opcional: isola a chave AES dos segredos de integração (vazio = deriva de JWT_SECRET):
#INTEGRATION_SECRETS_KEY=<hex-64 ou base64>
#INFOBIP_TIMEOUT_MS=10000

# Railway injeta PORT automaticamente — não definir.
# OTEL_SDK_DISABLED=true até haver coletor OTLP.
