# Referência das variáveis do serviço operations-api (Java/Spring Boot) no Railway.
# Aplicar com: railway variable set -s operations-api KEY=VALUE
# (segredos reais NÃO ficam aqui — gerar e aplicar via CLI)

# Postgres — mesmo banco do core-api (tabelas Java convivem no schema public).
DB_HOST=${{Postgres.PGHOST}}
DB_PORT=${{Postgres.PGPORT}}
DB_NAME=${{Postgres.PGDATABASE}}
DB_USER=${{Postgres.PGUSER}}
DB_PASSWORD=${{Postgres.PGPASSWORD}}

# Mesmo segredo HS256 do core-api — valida JWTs staff/portal.
JWT_SECRET=<o mesmo valor do core-api>

# Token service-to-service: o Java posta eventos financeiros em
# POST {CORE_API_URL}/api/v1/internal/eventos-financeiros com X-Service-Token.
# O MESMO valor precisa estar no core-api (senão o endpoint responde 503).
INTERNAL_SERVICE_TOKEN=<gerar: openssl rand -hex 32>

CORE_API_URL=http://core-api.railway.internal:8080
CORE_API_TIMEOUT_MS=4000

# Pagamento / fiscal / e-mail (stubs até credenciais reais de PSP/fiscal/SMTP):
PAYMENT_PROVIDER=stub
PAYMENT_STUB_WEBHOOK_SECRET=<gerar>
FISCAL_PROVIDER=stub
FISCAL_AUTO_EMIT=false
FISCAL_AMBIENTE=homologacao
EMAIL_PROVIDER=log
# Para SMTP real: EMAIL_PROVIDER=smtp + SMTP_HOST/SMTP_PORT/SMTP_USERNAME/SMTP_PASSWORD/MAIL_FROM

# Railway injeta PORT automaticamente — não definir.
# OTEL_SDK_DISABLED=true até haver coletor OTLP.
