# Referência das variáveis do serviço core-api no Railway.
# Aplicar com: railway variable set -s core-api KEY=VALUE
# (segredos reais NÃO ficam aqui — gerar e aplicar via CLI)

DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=<gerar: openssl rand -hex 32>
ENVIRONMENT=production
RUN_MIGRATIONS=true
SEED_ADMIN=true
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@seudominio.com
ADMIN_SENHA=<gerar>
CORS_ORIGINS=https://hweld-loja.vinicius-softengineer.workers.dev,https://hweld-admin.vinicius-softengineer.workers.dev
DB_MAX_CONNECTIONS=20

# Realtime (preencher quando realtime-engine estiver no ar):
# MOTOR_URL=http://realtime-engine.railway.internal:4100
# MOTOR_INGEST_TOKEN=<mesmo segredo do serviço motor>

# Busca (opcional — sem ELASTICSEARCH_URL a busca fica desligada):
# ELASTICSEARCH_URL=https://...
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=<...>
# ES_ENSURE_INDEX=true

# Object storage MinIO — OBRIGATÓRIO em prod: sem ele, uploads (imagens de
# produto, mídia CMS) caem no disco efêmero do container e se perdem a cada
# redeploy/restart. Mesmo bucket do operations-api.
# MINIO_ENDPOINT=https://bucket-production-e903.up.railway.app
# MINIO_BUCKET=hweld-uploads
# MINIO_REGION=us-east-1
# MINIO_ACCESS_KEY=<access key do MinIO>
# MINIO_SECRET_KEY=<secret key do MinIO>

# Docs da API — desligado por default em production (spec enumera rotas).
# API_DOCS_ENABLED=false
