# ── Infra compartilhada ───────────────────────────────────────────────────
DB_USER=hweld
DB_PASSWORD=                              # gerar: openssl rand -hex 32
DB_NAME=hweld

MINIO_ROOT_USER=hweld-admin
MINIO_ROOT_PASSWORD=                      # openssl rand -hex 32

# ── Segredos compartilhados pelos 3 serviços ──────────────────────────────
# JWT_SECRET precisa ter >=32 bytes e ser O MESMO nos dois backends.
JWT_SECRET=                               # openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=                   # openssl rand -hex 32
MOTOR_INGEST_TOKEN=                       # openssl rand -hex 32
SECRET_KEY_BASE=                          # openssl rand -hex 64 (Phoenix)
PAYMENT_STUB_WEBHOOK_SECRET=              # openssl rand -hex 32

# ── Core-api ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@hweld.local
ADMIN_SENHA=                              # senha do seed admin inicial
ADMIN_NOME=Administrador
# Domínios que fazem chamadas do browser (workers CF + painel admin).
CORS_ORIGINS=https://hweld-loja.vinicius-softengineer.workers.dev,https://hweld-admin.vinicius-softengineer.workers.dev
