server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Headers de segurança — clickjacking, MIME sniffing, referrer e CSP.
    # CSP: app Angular self-hosted; imagens de CMS/PSP podem vir de https
    # externo; ViaCEP é chamado direto pelo browser.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://sdk.mercadopago.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://viacep.com.br https://api.mercadopago.com https://*.mercadopago.com https://*.mercadolibre.com; frame-src https://*.mercadopago.com https://*.mercadolibre.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    # Pagamentos e logística vivem na operations-api (Java) — o restante
    # de /api/v1 segue para o core-api (Rust). proxy_pass via variável +
    # resolver: upstreams railway.internal mudam de IP a cada redeploy.
    # X-Edge-Token: este nginx É a borda — injeta o segredo que as origens
    # (edge guard) exigem. Origens acessadas direto pelo *.up.railway.app
    # sem o header morrem em 403.
    location ~ ^/api/v1/payments(/|$) {
        resolver [fd12::10] valid=10s ipv6=on;
        set $ops_upstream http://${OPS_UPSTREAM};
        proxy_pass $ops_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Edge-Token "${EDGE_TOKEN}";
    }

    location /api/v1/logistica/ {
        resolver [fd12::10] valid=10s ipv6=on;
        set $ops_upstream http://${OPS_UPSTREAM};
        proxy_pass $ops_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Edge-Token "${EDGE_TOKEN}";
    }

    location /api/v1/ {
        resolver [fd12::10] valid=10s ipv6=on;
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Edge-Token "${EDGE_TOKEN}";
    }

    # SSE do motor realtime — streaming sem buffer. Resolver obrigatório:
    # proxy_pass com variável sem resolver não resolve DNS e a conexão
    # cai (era o motivo do realtime não conectar).
    location /events {
        resolver [fd12::10] valid=10s ipv6=on;
        set $motor_upstream http://${MOTOR_UPSTREAM};
        proxy_pass $motor_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Edge-Token "${EDGE_TOKEN}";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # WebSocket do Phoenix Channels (/socket/websocket).
    location /socket {
        resolver [fd12::10] valid=10s ipv6=on;
        set $motor_upstream_ws http://${MOTOR_UPSTREAM};
        proxy_pass $motor_upstream_ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Edge-Token "${EDGE_TOKEN}";
        proxy_read_timeout 1h;
    }

    # SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
