server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/v1/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # SSE do motor realtime — streaming sem buffer.
    # X-Forwarded-Proto fixo: o hop interno é http mas o Plug.SSL
    # do Phoenix redireciona (301) se não vir https.
    location /events {
        proxy_pass http://${MOTOR_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # WebSocket do Phoenix Channels (/socket/websocket).
    location /socket {
        proxy_pass http://${MOTOR_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 1h;
    }

    # SPA fallback — todas as rotas do router caem no index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
