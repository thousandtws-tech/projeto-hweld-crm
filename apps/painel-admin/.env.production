# Build de produção (vite build → modo production).
# Same-origin: o Worker Cloudflare (infra/cloudflare) faz proxy de
# /api → core-api e /events → realtime-engine.
VITE_HW_API_URL=/api/v1
# Same-origin também — o Worker roteia /api/v1/{payments,billing,
# fiscal-documents,notifications,events,webhooks}* ao operations-api antes
# do fallback /api → core-api.
VITE_HW_OPS_API_URL=/api/v1
VITE_HW_REALTIME_URL=
