# Copie para .env.e2e (gitignored) e ajuste ao ambiente alvo.
# O que não for definido cai nos defaults abaixo / no .env do core-api.

# ── Serviços (dev local) ────────────────────────────────────────────────────
E2E_CORE_API=http://localhost:8080
E2E_OPS_API=http://localhost:8090
E2E_REALTIME=http://localhost:4100

# ── Frontends (só projetos *-ui) ────────────────────────────────────────────
E2E_WEB_URL=http://localhost:4210
E2E_ADMIN_URL=http://localhost:5173

# ── Credencial staff seed (SEED_ADMIN do core-api) ─────────────────────────
E2E_ADMIN_EMAIL=admin@hweld.local
E2E_ADMIN_SENHA=admin123

# ── Segredos de integração usados nos testes ────────────────────────────────
# HMAC dos webhooks do provider stub (hweld.payment.webhook-secrets.stub no Java).
E2E_WEBHOOK_SECRET=dev-stub-webhook-secret
# Bearer do POST /ingest no realtime-engine (fallback: MOTOR_INGEST_TOKEN do .env do core-api).
# E2E_MOTOR_INGEST_TOKEN=

# ── Alternativas ────────────────────────────────────────────────────────────
# Pular specs que dependem do realtime-engine (ele é opcional por design):
# E2E_SKIP_REALTIME=1
# Pular specs que dependem do Elasticsearch (busca desligada sem ELASTICSEARCH_URL):
# E2E_SKIP_BUSCA=1

# ── Exemplo: apontar para produção (workers.dev + railway) ──────────────────
# E2E_CORE_API=https://core-api-production-5553.up.railway.app
# E2E_OPS_API=https://operations-api-production-d580.up.railway.app
# E2E_REALTIME=https://realtime-engine-production-081f.up.railway.app
# E2E_WEB_URL=https://hweld-loja.<conta>.workers.dev
# E2E_ADMIN_URL=https://hweld-admin.<conta>.workers.dev
# ATENÇÃO: os specs SEMEIAM dados reais (empresas/pedidos/pagamentos stub).
# Apontar para produção só faz sentido com PAYMENT_PROVIDER=stub e base descartável.
