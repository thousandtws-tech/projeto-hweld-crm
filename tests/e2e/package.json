{
  "name": "hweld-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "Suíte E2E de sistema do monorepo HWeld — cobre core-api (Rust), operations-api (Java), realtime-engine (Elixir) e os dois frontends.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=portal-ui --project=admin-ui",
    "test:headed": "playwright test --project=portal-ui --project=admin-ui --headed",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@types/node": "^22.16.5",
    "typescript": "^5.8.3"
  }
}
